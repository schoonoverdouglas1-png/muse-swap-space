"body": {"content": [{"endIndex": 1, "sectionBreak": {"sectionStyle": {"columnSeparatorStyle": "NONE", "contentDirection": "LEFT_TO_RIGHT", "sectionType": "CONTINUOUS"}}}, {"endIndex": 26, "paragraph": {"elements": [{"endIndex": 26, "startIndex": 1, "textRun": {"content": "BOOK 2: Quantum Thinking\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.npeu475rhgr1", "namedStyleType": "HEADING_1"}}, "startIndex": 1}, {"endIndex": 74, "paragraph": {"elements": [{"endIndex": 74, "startIndex": 26, "textRun": {"content": "© 2026 Douglas Schoonover. All Rights Reserved.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 26}, {"endIndex": 75, "paragraph": {"elements": [{"endIndex": 75, "startIndex": 74, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "indentFirstLine": {"unit": "PT"}, "indentStart": {"unit": "PT"}, "namedStyleType": "NORMAL_TEXT", "spaceAbove": {"unit": "PT"}, "spaceBelow": {"unit": "PT"}}}, "startIndex": 74}, {"endIndex": 134, "paragraph": {"elements": [{"endIndex": 133, "startIndex": 75, "textRun": {"content": "Part of The Compendium — Application of Unified Relativity", "textStyle": {"bold": true}}}, {"endIndex": 134, "startIndex": 133, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 75}, {"endIndex": 176, "paragraph": {"elements": [{"endIndex": 176, "startIndex": 134, "textRun": {"content": "Core Equation: $E_c = \\sum w_i m_i v_i^x$\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.nnhdrrrul8gt", "namedStyleType": "HEADING_2"}}, "startIndex": 134}, {"endIndex": 209, "paragraph": {"elements": [{"endIndex": 209, "startIndex": 176, "textRun": {"content": "2. Variable Exponents in Biology\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.75di4ahpzlsc", "namedStyleType": "HEADING_2"}}, "startIndex": 176}, {"endIndex": 228, "paragraph": {"elements": [{"endIndex": 228, "startIndex": 209, "textRun": {"content": "2.1 Why $x \\neq 2$\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.efw1td6b2rq2", "namedStyleType": "HEADING_3"}}, "startIndex": 209}, {"endIndex": 426, "paragraph": {"elements": [{"endIndex": 426, "startIndex": 228, "textRun": {"content": "Einstein froze the universe with a fixed exponent. Bodies don't freeze. Chronic illness shows $x < 2$ (energy bleeds slowly), trauma shows $x > 2$ (energy spikes). Biology needs variable exponents.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 228}, {"endIndex": 464, "paragraph": {"elements": [{"endIndex": 464, "startIndex": 426, "textRun": {"content": "2.2 Entanglement Coefficients ($w_i$)\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.yo4cwl1gjkle", "namedStyleType": "HEADING_3"}}, "startIndex": 426}, {"endIndex": 690, "paragraph": {"elements": [{"endIndex": 690, "startIndex": 464, "textRun": {"content": "When external interference hits — bloggers, overseas inputs, corporate access, language injection — $w_i$ drops. Low $w_i$ = corrupted data. Switching systems (Google → Meta) was strategy to raise $w_i$ and restore integrity.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 464}, {"endIndex": 723, "paragraph": {"elements": [{"endIndex": 723, "startIndex": 690, "textRun": {"content": "2.3 Calculating Cognitive Output\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.n5arxhivnsoa", "namedStyleType": "HEADING_3"}}, "startIndex": 690}, {"endIndex": 887, "paragraph": {"elements": [{"endIndex": 887, "startIndex": 723, "textRun": {"content": "$v_i$ is how fast truth moves. Requirement: AI that processes while you type, no tabulating lockout. Real-time velocity matters for clinical and systemic analysis.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 723}, {"endIndex": 888, "paragraph": {"elements": [{"endIndex": 888, "startIndex": 887, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "indentFirstLine": {"unit": "PT"}, "indentStart": {"unit": "PT"}, "namedStyleType": "NORMAL_TEXT", "spaceAbove": {"unit": "PT"}, "spaceBelow": {"unit": "PT"}}}, "startIndex": 887}, {"endIndex": 890, "paragraph": {"elements": [{"endIndex": 889, "horizontalRule": {"textStyle": {}}, "startIndex": 888}, {"endIndex": 890, "startIndex": 889, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 888}, {"endIndex": 891, "paragraph": {"elements": [{"endIndex": 891, "startIndex": 890, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "indentFirstLine": {"unit": "PT"}, "indentStart": {"unit": "PT"}, "namedStyleType": "NORMAL_TEXT", "spaceAbove": {"unit": "PT"}, "spaceBelow": {"unit": "PT"}}}, "startIndex": 890}, {"endIndex": 960, "paragraph": {"elements": [{"endIndex": 959, "startIndex": 891, "textRun": {"content": "Next: Expand with Quantum Thinking applications to systemic analysis", "textStyle": {"italic": true}}}, {"endIndex": 960, "startIndex": 959, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 891}]},
