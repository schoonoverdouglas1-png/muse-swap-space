"body": {"content": [{"endIndex": 1, "sectionBreak": {"sectionStyle": {"columnSeparatorStyle": "NONE", "contentDirection": "LEFT_TO_RIGHT", "sectionType": "CONTINUOUS"}}}, {"endIndex": 47, "paragraph": {"elements": [{"endIndex": 47, "startIndex": 1, "textRun": {"content": "BOOK 4: Clinical Diagnostic Technician Manual\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.jf3lxbr6vi1r", "namedStyleType": "HEADING_1"}}, "startIndex": 1}, {"endIndex": 95, "paragraph": {"elements": [{"endIndex": 95, "startIndex": 47, "textRun": {"content": "© 2026 Douglas Schoonover. All Rights Reserved.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 47}, {"endIndex": 96, "paragraph": {"elements": [{"endIndex": 96, "startIndex": 95, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "indentFirstLine": {"unit": "PT"}, "indentStart": {"unit": "PT"}, "namedStyleType": "NORMAL_TEXT", "spaceAbove": {"unit": "PT"}, "spaceBelow": {"unit": "PT"}}}, "startIndex": 95}, {"endIndex": 167, "paragraph": {"elements": [{"endIndex": 166, "startIndex": 96, "textRun": {"content": "Standalone Procedural Guide — Out of Scientific Existence, Pure Action", "textStyle": {"bold": true}}}, {"endIndex": 167, "startIndex": 166, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 96}, {"endIndex": 209, "paragraph": {"elements": [{"endIndex": 209, "startIndex": 167, "textRun": {"content": "Core Equation: $E_c = \\sum w_i m_i v_i^x$\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.96iydcy5dbax", "namedStyleType": "HEADING_2"}}, "startIndex": 167}, {"endIndex": 236, "paragraph": {"elements": [{"endIndex": 236, "startIndex": 209, "textRun": {"content": "2. The 5-Step Field Repair\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.h63naqcyq4jr", "namedStyleType": "HEADING_2"}}, "startIndex": 209}, {"endIndex": 254, "paragraph": {"elements": [{"endIndex": 254, "startIndex": 236, "textRun": {"content": "2.1 Lock the Room\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.5s0niszbnxnb", "namedStyleType": "HEADING_3"}}, "startIndex": 236}, {"endIndex": 345, "paragraph": {"elements": [{"endIndex": 345, "startIndex": 254, "textRun": {"content": "Patient's words first. No chart, no prior note, no hearsay enters until you lock the room.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 254}, {"endIndex": 362, "paragraph": {"elements": [{"endIndex": 362, "startIndex": 345, "textRun": {"content": "2.2 Find the Lie\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.djcfpib7ryrf", "namedStyleType": "HEADING_3"}}, "startIndex": 345}, {"endIndex": 467, "paragraph": {"elements": [{"endIndex": 467, "startIndex": 362, "textRun": {"content": "Strike copy/paste. Identify systemic fiction. If it wasn't observed in this encounter, it doesn't exist.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 362}, {"endIndex": 481, "paragraph": {"elements": [{"endIndex": 481, "startIndex": 467, "textRun": {"content": "2.3 Calculate\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.q1na4uia4k02", "namedStyleType": "HEADING_3"}}, "startIndex": 467}, {"endIndex": 582, "paragraph": {"elements": [{"endIndex": 582, "startIndex": 481, "textRun": {"content": "Run $E_c$. Severity x entanglement x velocity with variable exponent. High $E_c$ = immediate action.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 481}, {"endIndex": 599, "paragraph": {"elements": [{"endIndex": 599, "startIndex": 582, "textRun": {"content": "2.4 Cut & Rename\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.z9gvto4ap3p", "namedStyleType": "HEADING_3"}}, "startIndex": 582}, {"endIndex": 668, "paragraph": {"elements": [{"endIndex": 668, "startIndex": 599, "textRun": {"content": "Remove fiction, increase entanglement. Use Nameology to raise $w_i$.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 599}, {"endIndex": 677, "paragraph": {"elements": [{"endIndex": 677, "startIndex": 668, "textRun": {"content": "2.5 Sign\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.yhkfzi87123l", "namedStyleType": "HEADING_3"}}, "startIndex": 668}, {"endIndex": 794, "paragraph": {"elements": [{"endIndex": 794, "startIndex": 677, "textRun": {"content": "You are final authority. Clinical Diagnostic Technician signature is closure. No override without repeat of 2.1-2.4.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 677}, {"endIndex": 795, "paragraph": {"elements": [{"endIndex": 795, "startIndex": 794, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "indentFirstLine": {"unit": "PT"}, "indentStart": {"unit": "PT"}, "namedStyleType": "NORMAL_TEXT", "spaceAbove": {"unit": "PT"}, "spaceBelow": {"unit": "PT"}}}, "startIndex": 794}, {"endIndex": 797, "paragraph": {"elements": [{"endIndex": 796, "horizontalRule": {"textStyle": {}}, "startIndex": 795}, {"endIndex": 797, "startIndex": 796, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 795}, {"endIndex": 798, "paragraph": {"elements": [{"endIndex": 798, "startIndex": 797, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "indentFirstLine": {"unit": "PT"}, "indentStart": {"unit": "PT"}, "namedStyleType": "NORMAL_TEXT", "spaceAbove": {"unit": "PT"}, "spaceBelow": {"unit": "PT"}}}, "startIndex": 797}, {"endIndex": 890, "paragraph": {"elements": [{"endIndex": 889, "startIndex": 798, "textRun": {"content": "Publish-ready: 10-page expanded version with field examples and checklists to be built next", "textStyle": {"italic": true}}}, {"endIndex": 890, "startIndex": 889, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 798}]},
