"body": {"content": [{"endIndex": 1, "sectionBreak": {"sectionStyle": {"columnSeparatorStyle": "NONE", "contentDirection": "LEFT_TO_RIGHT", "sectionType": "CONTINUOUS"}}}, {"endIndex": 31, "paragraph": {"elements": [{"endIndex": 31, "startIndex": 1, "textRun": {"content": "BOOK 1: A Pathway to the Cure\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.y3zoy344yf13", "namedStyleType": "HEADING_1"}}, "startIndex": 1}, {"endIndex": 79, "paragraph": {"elements": [{"endIndex": 79, "startIndex": 31, "textRun": {"content": "© 2026 Douglas Schoonover. All Rights Reserved.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 31}, {"endIndex": 80, "paragraph": {"elements": [{"endIndex": 80, "startIndex": 79, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "indentFirstLine": {"unit": "PT"}, "indentStart": {"unit": "PT"}, "namedStyleType": "NORMAL_TEXT", "spaceAbove": {"unit": "PT"}, "spaceBelow": {"unit": "PT"}}}, "startIndex": 79}, {"endIndex": 131, "paragraph": {"elements": [{"endIndex": 130, "startIndex": 80, "textRun": {"content": "Part of The Compendium — Unified Relativity Series", "textStyle": {"bold": true}}}, {"endIndex": 131, "startIndex": 130, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 80}, {"endIndex": 173, "paragraph": {"elements": [{"endIndex": 173, "startIndex": 131, "textRun": {"content": "Core Equation: $E_c = \\sum w_i m_i v_i^x$\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.qzgb5fdbcj0e", "namedStyleType": "HEADING_2"}}, "startIndex": 131}, {"endIndex": 200, "paragraph": {"elements": [{"endIndex": 200, "startIndex": 173, "textRun": {"content": "2. Core Evidence Protocols\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.dxbr6h4j9nbd", "namedStyleType": "HEADING_2"}}, "startIndex": 173}, {"endIndex": 222, "paragraph": {"elements": [{"endIndex": 222, "startIndex": 200, "textRun": {"content": "2.1 The Lock Protocol\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.pl9xfm8palna", "namedStyleType": "HEADING_3"}}, "startIndex": 200}, {"endIndex": 427, "paragraph": {"elements": [{"endIndex": 427, "startIndex": 222, "textRun": {"content": "Close all prior notes. Only what you observe exists in this encounter. This stops systemic fiction, copy/paste corruption, and inherited errors from entering the chart. Evidence begins at zero every time.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 222}, {"endIndex": 455, "paragraph": {"elements": [{"endIndex": 455, "startIndex": 427, "textRun": {"content": "2.2 The $E_c$ Reality Check\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.o3o2ciprsxld", "namedStyleType": "HEADING_3"}}, "startIndex": 427}, {"endIndex": 695, "paragraph": {"elements": [{"endIndex": 695, "startIndex": 455, "textRun": {"content": "At bedside: mass ($m_i$) = severity, entanglement ($w_i$) = how many conflicting opinions are pulling on the data, velocity ($v_i$) = time since onset. If $E_c$ is high, act now. This replaces static $E=mc^2$ with dynamic clinical reality.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 455}, {"endIndex": 725, "paragraph": {"elements": [{"endIndex": 725, "startIndex": 695, "textRun": {"content": "2.3 Final Authority Signature\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.67rrymee3dv1", "namedStyleType": "HEADING_3"}}, "startIndex": 695}, {"endIndex": 866, "paragraph": {"elements": [{"endIndex": 866, "startIndex": 725, "textRun": {"content": "You sign as Clinical Diagnostic Technician. No committee overrides without repeating 2.1-2.2. Final authority rests with direct observation.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 725}, {"endIndex": 867, "paragraph": {"elements": [{"endIndex": 867, "startIndex": 866, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "indentFirstLine": {"unit": "PT"}, "indentStart": {"unit": "PT"}, "namedStyleType": "NORMAL_TEXT", "spaceAbove": {"unit": "PT"}, "spaceBelow": {"unit": "PT"}}}, "startIndex": 866}, {"endIndex": 869, "paragraph": {"elements": [{"endIndex": 868, "horizontalRule": {"textStyle": {}}, "startIndex": 867}, {"endIndex": 869, "startIndex": 868, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 867}, {"endIndex": 870, "paragraph": {"elements": [{"endIndex": 870, "startIndex": 869, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "indentFirstLine": {"unit": "PT"}, "indentStart": {"unit": "PT"}, "namedStyleType": "NORMAL_TEXT", "spaceAbove": {"unit": "PT"}, "spaceBelow": {"unit": "PT"}}}, "startIndex": 869}, {"endIndex": 951, "paragraph": {"elements": [{"endIndex": 950, "startIndex": 870, "textRun": {"content": "Next: Expand each 2.x to 150-200 word publish-ready paragraph with case examples", "textStyle": {"italic": true}}}, {"endIndex": 951, "startIndex": 950, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 870}]},
