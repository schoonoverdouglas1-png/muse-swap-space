"body": {"content": [{"endIndex": 1, "sectionBreak": {"sectionStyle": {"columnSeparatorStyle": "NONE", "contentDirection": "LEFT_TO_RIGHT", "sectionType": "CONTINUOUS"}}}, {"endIndex": 38, "paragraph": {"elements": [{"endIndex": 38, "startIndex": 1, "textRun": {"content": "Doug's Thoughts on Teaching Medicine\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.xjbv8n9qjlxc", "namedStyleType": "TITLE"}}, "startIndex": 1}, {"endIndex": 67, "paragraph": {"elements": [{"endIndex": 67, "startIndex": 38, "textRun": {"content": "Preface & Bedside Philosophy\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.nomzqdpte7ay", "namedStyleType": "HEADING_1"}}, "startIndex": 38}, {"endIndex": 518, "paragraph": {"elements": [{"endIndex": 518, "startIndex": 67, "textRun": {"content": "Medicine in its truest form is an active, dynamic commitment to restoring the human being—not merely managing symptoms or adhering strictly to static algorithmic guidelines. Inspired by the proactive public health spirit of pioneers like Dr. C. Everett Koop, the primary duty of a clinical practitioner is to listen intently, observe direct physiological responses, and possess the courage to adapt protocols when a patient hits therapeutic ceilings.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 67}, {"endIndex": 582, "paragraph": {"elements": [{"endIndex": 582, "startIndex": 518, "textRun": {"content": "Chapter 1: The Mechanical Physiology Model (The 5-Wheel System)\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.b69nkva5xzat", "namedStyleType": "HEADING_1"}}, "startIndex": 518}, {"endIndex": 713, "paragraph": {"elements": [{"endIndex": 713, "startIndex": 582, "textRun": {"content": "Pathology is best understood not as isolated organ failure, but as a systemic \"gear-lock\" between macro-systems and micro-systems.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 582}, {"endIndex": 714, "paragraph": {"elements": [{"endIndex": 714, "startIndex": 713, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "indentFirstLine": {"unit": "PT"}, "indentStart": {"unit": "PT"}, "namedStyleType": "NORMAL_TEXT", "spaceAbove": {"unit": "PT"}, "spaceBelow": {"unit": "PT"}}}, "startIndex": 713}, {"endIndex": 816, "paragraph": {"bullet": {"listId": "kix.u0nb7wfafr91", "textStyle": {}}, "elements": [{"endIndex": 738, "startIndex": 714, "textRun": {"content": "The Central Drive Wheel:", "textStyle": {"bold": true}}}, {"endIndex": 816, "startIndex": 738, "textRun": {"content": " Determines the net direction and momentum of health versus systemic disease.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "indentFirstLine": {"magnitude": 18, "unit": "PT"}, "indentStart": {"magnitude": 36, "unit": "PT"}, "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 714}, {"endIndex": 961, "paragraph": {"bullet": {"listId": "kix.u0nb7wfafr91", "textStyle": {}}, "elements": [{"endIndex": 848, "startIndex": 816, "textRun": {"content": "Macro-Cogs (Host & Environment):", "textStyle": {"bold": true}}}, {"endIndex": 961, "startIndex": 848, "textRun": {"content": " Large, slow-moving biological forces including host genetics, physiology, and seasonal/environmental phenology.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "indentFirstLine": {"magnitude": 18, "unit": "PT"}, "indentStart": {"magnitude": 36, "unit": "PT"}, "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 816}, {"endIndex": 1100, "paragraph": {"bullet": {"listId": "kix.u0nb7wfafr91", "textStyle": {}}, "elements": [{"endIndex": 992, "startIndex": 961, "textRun": {"content": "Micro-Cogs (Biomes & Microbes):", "textStyle": {"bold": true}}}, {"endIndex": 1100, "startIndex": 992, "textRun": {"content": " Rapidly spinning, highly responsive microscopic ecosystems comprising bacteria, fungi, and resident flora.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "indentFirstLine": {"magnitude": 18, "unit": "PT"}, "indentStart": {"magnitude": 36, "unit": "PT"}, "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 961}, {"endIndex": 1145, "paragraph": {"bullet": {"listId": "kix.u0nb7wfafr91", "textStyle": {}}, "elements": [{"endIndex": 1144, "startIndex": 1100, "textRun": {"content": "Diagnostic States (State 1 through State 4):", "textStyle": {"bold": true}}}, {"endIndex": 1145, "startIndex": 1144, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "indentFirstLine": {"magnitude": 18, "unit": "PT"}, "indentStart": {"magnitude": 36, "unit": "PT"}, "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 1100}, {"endIndex": 1218, "paragraph": {"bullet": {"listId": "kix.u0nb7wfafr91", "nestingLevel": 1, "textStyle": {}}, "elements": [{"endIndex": 1157, "startIndex": 1145, "textRun": {"content": "State 1 & 2:", "textStyle": {"italic": true}}}, {"endIndex": 1218, "startIndex": 1157, "textRun": {"content": " Early friction and partial slippage between host and biome.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "indentFirstLine": {"magnitude": 54, "unit": "PT"}, "indentStart": {"magnitude": 72, "unit": "PT"}, "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 1145}, {"endIndex": 1322, "paragraph": {"bullet": {"listId": "kix.u0nb7wfafr91", "nestingLevel": 1, "textStyle": {}}, "elements": [{"endIndex": 1230, "startIndex": 1218, "textRun": {"content": "State 3 & 4:", "textStyle": {"italic": true}}}, {"endIndex": 1322, "startIndex": 1230, "textRun": {"content": " Deep multi-wheel interlock resulting in severe chronic inflammation and stalled clearance.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "indentFirstLine": {"magnitude": 54, "unit": "PT"}, "indentStart": {"magnitude": 72, "unit": "PT"}, "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 1218}, {"endIndex": 1371, "paragraph": {"elements": [{"endIndex": 1371, "startIndex": 1322, "textRun": {"content": "Chapter 2: Biome-First Medicine & Kinetic Dosing\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.irmootih44uq", "namedStyleType": "HEADING_1"}}, "startIndex": 1322}, {"endIndex": 1491, "paragraph": {"elements": [{"endIndex": 1491, "startIndex": 1371, "textRun": {"content": "True healing requires addressing the terrain and the resident micro-ecosystem before expecting host tissues to recover.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 1371}, {"endIndex": 1518, "paragraph": {"elements": [{"endIndex": 1518, "startIndex": 1491, "textRun": {"content": "Medicating the Biome First\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.xikd1gukia3", "namedStyleType": "HEADING_2"}}, "startIndex": 1491}, {"endIndex": 1712, "paragraph": {"elements": [{"endIndex": 1712, "startIndex": 1518, "textRun": {"content": "Therapeutic agents (e.g., Doxycycline, azole antifungals, Ivermectin, low-dose steroids) alter the biochemical fluid in which microbes reside, relieving inflammatory friction across micro-cogs.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 1518}, {"endIndex": 1746, "paragraph": {"elements": [{"endIndex": 1746, "startIndex": 1712, "textRun": {"content": "Immunomodulation over Eradication\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.ghfczewggh3n", "namedStyleType": "HEADING_2"}}, "startIndex": 1712}, {"endIndex": 1959, "paragraph": {"elements": [{"endIndex": 1959, "startIndex": 1746, "textRun": {"content": "Many agents work primarily by tuning host immune signaling (e.g., downregulating TLR4 and cytokine cascades), enabling native mucosal mechanisms to sweep out overgrowth rather than acting purely as harsh poisons.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 1746}, {"endIndex": 1981, "paragraph": {"elements": [{"endIndex": 1981, "startIndex": 1959, "textRun": {"content": "Kinetic Dosing Levers\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.9t97zm98vibf", "namedStyleType": "HEADING_2"}}, "startIndex": 1959}, {"endIndex": 2091, "paragraph": {"bullet": {"listId": "kix.a3nrb1sqeehk", "textStyle": {}}, "elements": [{"endIndex": 1995, "startIndex": 1981, "textRun": {"content": "Loading Doses:", "textStyle": {"bold": true}}}, {"endIndex": 2091, "startIndex": 1995, "textRun": {"content": " Rapidly establish therapeutic tissue levels during acute flares to overcome microbial inertia.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "indentFirstLine": {"magnitude": 18, "unit": "PT"}, "indentStart": {"magnitude": 36, "unit": "PT"}, "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 1981}, {"endIndex": 2224, "paragraph": {"bullet": {"listId": "kix.a3nrb1sqeehk", "textStyle": {}}, "elements": [{"endIndex": 2121, "startIndex": 2091, "textRun": {"content": "Maintenance Packages & Tapers:", "textStyle": {"bold": true}}}, {"endIndex": 2224, "startIndex": 2121, "textRun": {"content": " Lower, sustained doses prevent medication overload while keeping disease counter-rotation suppressed.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "indentFirstLine": {"magnitude": 18, "unit": "PT"}, "indentStart": {"magnitude": 36, "unit": "PT"}, "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 2091}, {"endIndex": 2334, "paragraph": {"bullet": {"listId": "kix.a3nrb1sqeehk", "textStyle": {}}, "elements": [{"endIndex": 2251, "startIndex": 2224, "textRun": {"content": "Stepped & Pulsed Schedules:", "textStyle": {"bold": true}}}, {"endIndex": 2334, "startIndex": 2251, "textRun": {"content": " Prevent resistance plateaus and accommodate individual metabolic clearance rates.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "indentFirstLine": {"magnitude": 18, "unit": "PT"}, "indentStart": {"magnitude": 36, "unit": "PT"}, "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 2224}, {"endIndex": 2399, "paragraph": {"elements": [{"endIndex": 2399, "startIndex": 2334, "textRun": {"content": "Chapter 3: The Multi-Kingdom Virome & Biological Waste Clearance\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.u9roi82a1qjn", "namedStyleType": "HEADING_1"}}, "startIndex": 2334}, {"endIndex": 2561, "paragraph": {"elements": [{"endIndex": 2561, "startIndex": 2399, "textRun": {"content": "Viruses and viral fragments serve as foundational genetic building blocks shared across human host DNA, native microbial ecosystems, and the wider natural world.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 2399}, {"endIndex": 2585, "paragraph": {"elements": [{"endIndex": 2585, "startIndex": 2561, "textRun": {"content": "The 6-Tier Viral Matrix\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.nxzyn4uncysw", "namedStyleType": "HEADING_2"}}, "startIndex": 2561}, {"endIndex": 3274, "startIndex": 2585, "table": {"columns": 3, "rows": 7, "tableRows": [{"endIndex": 2622, "startIndex": 2586, "tableCells": [{"content": [{"endIndex": 2593, "paragraph": {"elements": [{"endIndex": 2593, "startIndex": 2588, "textRun": {"content": "Tier\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 2588}], "endIndex": 2593, "startIndex": 2587, "tableCellStyle": {"columnSpan": 1, "rowSpan": 1}}, {"content": [{"endIndex": 2609, "paragraph": {"elements": [{"endIndex": 2609, "startIndex": 2594, "textRun": {"content": "Classification\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 2594}], "endIndex": 2609, "startIndex": 2593, "tableCellStyle": {"columnSpan": 1, "rowSpan": 1}}, {"content": [{"endIndex": 2622, "paragraph": {"elements": [{"endIndex": 2622, "startIndex": 2610, "textRun": {"content": "Description\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 2610}], "endIndex": 2622, "startIndex": 2609, "tableCellStyle": {"columnSpan": 1, "rowSpan": 1}}], "tableRowStyle": {"minRowHeight": {"unit": "PT"}, "tableHeader": true}}, {"endIndex": 2717, "startIndex": 2622, "tableCells": [{"content": [{"endIndex": 2631, "paragraph": {"elements": [{"endIndex": 2630, "startIndex": 2624, "textRun": {"content": "Tier 1", "textStyle": {"bold": true}}}, {"endIndex": 2631, "startIndex": 2630, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 2624}], "endIndex": 2631, "startIndex": 2623, "tableCellStyle": {"columnSpan": 1, "rowSpan": 1}}, {"content": [{"endIndex": 2660, "paragraph": {"elements": [{"endIndex": 2660, "startIndex": 2632, "textRun": {"content": "Giant Environmental Viruses\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 2632}], "endIndex": 2660, "startIndex": 2631, "tableCellStyle": {"columnSpan": 1, "rowSpan": 1}}, {"content": [{"endIndex": 2717, "paragraph": {"elements": [{"endIndex": 2717, "startIndex": 2661, "textRun": {"content": "Megaviruses bridging cellular machinery and viral code.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 2661}], "endIndex": 2717, "startIndex": 2660, "tableCellStyle": {"columnSpan": 1, "rowSpan": 1}}], "tableRowStyle": {"minRowHeight": {"unit": "PT"}}}, {"endIndex": 2833, "startIndex": 2717, "tableCells": [{"content": [{"endIndex": 2726, "paragraph": {"elements": [{"endIndex": 2725, "startIndex": 2719, "textRun": {"content": "Tier 2", "textStyle": {"bold": true}}}, {"endIndex": 2726, "startIndex": 2725, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 2719}], "endIndex": 2726, "startIndex": 2718, "tableCellStyle": {"columnSpan": 1, "rowSpan": 1}}, {"content": [{"endIndex": 2757, "paragraph": {"elements": [{"endIndex": 2757, "startIndex": 2727, "textRun": {"content": "Endogenous Retroviral Genomes\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 2727}], "endIndex": 2757, "startIndex": 2726, "tableCellStyle": {"columnSpan": 1, "rowSpan": 1}}, {"content": [{"endIndex": 2833, "paragraph": {"elements": [{"endIndex": 2833, "startIndex": 2758, "textRun": {"content": "HERVs comprising ~8% of human DNA, representing integrated ancestral code.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 2758}], "endIndex": 2833, "startIndex": 2757, "tableCellStyle": {"columnSpan": 1, "rowSpan": 1}}], "tableRowStyle": {"minRowHeight": {"unit": "PT"}}}, {"endIndex": 2987, "startIndex": 2833, "tableCells": [{"content": [{"endIndex": 2842, "paragraph": {"elements": [{"endIndex": 2841, "startIndex": 2835, "textRun": {"content": "Tier 3", "textStyle": {"bold": true}}}, {"endIndex": 2842, "startIndex": 2841, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 2835}], "endIndex": 2842, "startIndex": 2834, "tableCellStyle": {"columnSpan": 1, "rowSpan": 1}}, {"content": [{"endIndex": 2870, "paragraph": {"elements": [{"endIndex": 2870, "startIndex": 2843, "textRun": {"content": "Complex Eukaryotic Viruses\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 2843}], "endIndex": 2870, "startIndex": 2842, "tableCellStyle": {"columnSpan": 1, "rowSpan": 1}}, {"content": [{"endIndex": 2987, "paragraph": {"elements": [{"endIndex": 2987, "startIndex": 2871, "textRun": {"content": "Coronaviruses, Arboviruses, and Herpesviruses capable of sub-genomic expression ($S, M, E, N$ structural packages).\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 2871}], "endIndex": 2987, "startIndex": 2870, "tableCellStyle": {"columnSpan": 1, "rowSpan": 1}}], "tableRowStyle": {"minRowHeight": {"unit": "PT"}}}, {"endIndex": 3075, "startIndex": 2987, "tableCells": [{"content": [{"endIndex": 2996, "paragraph": {"elements": [{"endIndex": 2995, "startIndex": 2989, "textRun": {"content": "Tier 4", "textStyle": {"bold": true}}}, {"endIndex": 2996, "startIndex": 2995, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 2989}], "endIndex": 2996, "startIndex": 2988, "tableCellStyle": {"columnSpan": 1, "rowSpan": 1}}, {"content": [{"endIndex": 3012, "paragraph": {"elements": [{"endIndex": 3012, "startIndex": 2997, "textRun": {"content": "Bacteriophages\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 2997}], "endIndex": 3012, "startIndex": 2996, "tableCellStyle": {"columnSpan": 1, "rowSpan": 1}}, {"content": [{"endIndex": 3075, "paragraph": {"elements": [{"endIndex": 3075, "startIndex": 3013, "textRun": {"content": "The dominant virome controlling native bacterial populations.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 3013}], "endIndex": 3075, "startIndex": 3012, "tableCellStyle": {"columnSpan": 1, "rowSpan": 1}}], "tableRowStyle": {"minRowHeight": {"unit": "PT"}}}, {"endIndex": 3167, "startIndex": 3075, "tableCells": [{"content": [{"endIndex": 3084, "paragraph": {"elements": [{"endIndex": 3083, "startIndex": 3077, "textRun": {"content": "Tier 5", "textStyle": {"bold": true}}}, {"endIndex": 3084, "startIndex": 3083, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 3077}], "endIndex": 3084, "startIndex": 3076, "tableCellStyle": {"columnSpan": 1, "rowSpan": 1}}, {"content": [{"endIndex": 3119, "paragraph": {"elements": [{"endIndex": 3119, "startIndex": 3085, "textRun": {"content": "Extracellular Vesicles & Exosomes\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 3085}], "endIndex": 3119, "startIndex": 3084, "tableCellStyle": {"columnSpan": 1, "rowSpan": 1}}, {"content": [{"endIndex": 3167, "paragraph": {"elements": [{"endIndex": 3167, "startIndex": 3120, "textRun": {"content": "The body's cellular garbage-disposal packages.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 3120}], "endIndex": 3167, "startIndex": 3119, "tableCellStyle": {"columnSpan": 1, "rowSpan": 1}}], "tableRowStyle": {"minRowHeight": {"unit": "PT"}}}, {"endIndex": 3273, "startIndex": 3167, "tableCells": [{"content": [{"endIndex": 3176, "paragraph": {"elements": [{"endIndex": 3175, "startIndex": 3169, "textRun": {"content": "Tier 6", "textStyle": {"bold": true}}}, {"endIndex": 3176, "startIndex": 3175, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 3169}], "endIndex": 3176, "startIndex": 3168, "tableCellStyle": {"columnSpan": 1, "rowSpan": 1}}, {"content": [{"endIndex": 3208, "paragraph": {"elements": [{"endIndex": 3208, "startIndex": 3177, "textRun": {"content": "Viroids & Mobile RNA Fragments\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 3177}], "endIndex": 3208, "startIndex": 3176, "tableCellStyle": {"columnSpan": 1, "rowSpan": 1}}, {"content": [{"endIndex": 3273, "paragraph": {"elements": [{"endIndex": 3273, "startIndex": 3209, "textRun": {"content": "Transposons and microRNAs serving as baseline genetic currency.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 3209}], "endIndex": 3273, "startIndex": 3208, "tableCellStyle": {"columnSpan": 1, "rowSpan": 1}}], "tableRowStyle": {"minRowHeight": {"unit": "PT"}}}], "tableStyle": {"tableColumnProperties": [{"width": {"magnitude": 175, "unit": "PT"}, "widthType": "FIXED_WIDTH"}, {"width": {"magnitude": 175, "unit": "PT"}, "widthType": "FIXED_WIDTH"}, {"width": {"magnitude": 175, "unit": "PT"}, "widthType": "FIXED_WIDTH"}]}}}, {"endIndex": 3308, "paragraph": {"elements": [{"endIndex": 3308, "startIndex": 3274, "textRun": {"content": "Phlegm, Mucus, and Genetic Sludge\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.5yrx4vi4pr64", "namedStyleType": "HEADING_2"}}, "startIndex": 3274}, {"endIndex": 3661, "paragraph": {"elements": [{"endIndex": 3661, "startIndex": 3308, "textRun": {"content": "When host tissues and biome flora undergo stress, cells release billions of extracellular vesicles packed with degraded RNA, viral fragments, and cellular waste. Mucus and phlegm are the physical, mechanical manifestations of this garbage-disposal process—the body's active attempt to flush out spent biological sludge and restore homeostatic momentum.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 3308}]},
