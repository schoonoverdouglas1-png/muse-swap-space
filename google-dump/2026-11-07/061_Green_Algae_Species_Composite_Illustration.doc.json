"body": {"content": [{"endIndex": 1, "sectionBreak": {"sectionStyle": {"columnSeparatorStyle": "NONE", "contentDirection": "LEFT_TO_RIGHT", "sectionType": "CONTINUOUS"}}}, {"endIndex": 44, "paragraph": {"elements": [{"endIndex": 44, "startIndex": 1, "textRun": {"content": "Green Algae Species Composite Illustration\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.bclugierg0l", "namedStyleType": "TITLE"}}, "startIndex": 1}, {"endIndex": 111, "paragraph": {"elements": [{"endIndex": 111, "startIndex": 44, "textRun": {"content": "Taxonomic Plate and Morphological Overview of Selected Chlorophyta\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 44}, {"endIndex": 129, "paragraph": {"elements": [{"endIndex": 129, "startIndex": 111, "textRun": {"content": "Plate Description\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.lou5rspjjl7m", "namedStyleType": "HEADING_1"}}, "startIndex": 111}, {"endIndex": 563, "paragraph": {"elements": [{"endIndex": 296, "startIndex": 129, "textRun": {"content": "This composite biological illustration provides a detailed morphological comparison of four representative freshwater unicellular species within the chlorophyte genus ", "textStyle": {}}}, {"endIndex": 309, "startIndex": 296, "textRun": {"content": "Haematococcus", "textStyle": {"italic": true}}}, {"endIndex": 563, "startIndex": 309, "textRun": {"content": ". Characterized by their biflagellate motile stages and secondary carotenoid accumulation, the depicted taxa illustrate subtle phenotypic variations in cell wall gelatinous matrices, cytoplasmic projections, protoplast dimensions, and encystment stages.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 129}, {"endIndex": 564, "paragraph": {"elements": [{"endIndex": 564, "startIndex": 563, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "indentFirstLine": {"unit": "PT"}, "indentStart": {"unit": "PT"}, "namedStyleType": "NORMAL_TEXT", "spaceAbove": {"unit": "PT"}, "spaceBelow": {"unit": "PT"}}}, "startIndex": 563}, {"endIndex": 620, "paragraph": {"elements": [{"endIndex": 620, "startIndex": 564, "textRun": {"content": "The plate illustrates and contrasts the following taxa:\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 564}, {"endIndex": 621, "paragraph": {"elements": [{"endIndex": 621, "startIndex": 620, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "indentFirstLine": {"unit": "PT"}, "indentStart": {"unit": "PT"}, "namedStyleType": "NORMAL_TEXT", "spaceAbove": {"unit": "PT"}, "spaceBelow": {"unit": "PT"}}}, "startIndex": 620}, {"endIndex": 796, "paragraph": {"bullet": {"listId": "kix.hfiia66t905u", "textStyle": {}}, "elements": [{"endIndex": 644, "startIndex": 621, "textRun": {"content": "Haematococcus lacustris", "textStyle": {"bold": true, "italic": true}}}, {"endIndex": 796, "startIndex": 644, "textRun": {"content": ": Shown highlighting typical spherical to ellipsoid vegetative cells with distinct cytoplasmic bridges extending through a broadened gelatinous sheath.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "indentFirstLine": {"magnitude": 18, "unit": "PT"}, "indentStart": {"magnitude": 36, "unit": "PT"}, "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 621}, {"endIndex": 984, "paragraph": {"bullet": {"listId": "kix.hfiia66t905u", "textStyle": {}}, "elements": [{"endIndex": 819, "startIndex": 796, "textRun": {"content": "Haematococcus pluvialis", "textStyle": {"bold": true, "italic": true}}}, {"endIndex": 984, "startIndex": 819, "textRun": {"content": ": Depicted across life cycle transitions, detailing both the bi-flagellated motile state and the thick-walled haematocyst phase dense with astaxanthin pigmentation.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "indentFirstLine": {"magnitude": 18, "unit": "PT"}, "indentStart": {"magnitude": 36, "unit": "PT"}, "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 796}, {"endIndex": 1174, "paragraph": {"bullet": {"listId": "kix.hfiia66t905u", "textStyle": {}}, "elements": [{"endIndex": 1007, "startIndex": 984, "textRun": {"content": "Haematococcus thermalis", "textStyle": {"bold": true, "italic": true}}}, {"endIndex": 1174, "startIndex": 1007, "textRun": {"content": ": Illustrated with particular focus on compact protoplast boundaries and adaptations associated with elevated thermal tolerances in natural thermal seep environments.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "indentFirstLine": {"magnitude": 18, "unit": "PT"}, "indentStart": {"magnitude": 36, "unit": "PT"}, "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 984}, {"endIndex": 1314, "paragraph": {"bullet": {"listId": "kix.hfiia66t905u", "textStyle": {}}, "elements": [{"endIndex": 1194, "startIndex": 1174, "textRun": {"content": "Haematococcus rubens", "textStyle": {"bold": true, "italic": true}}}, {"endIndex": 1314, "startIndex": 1194, "textRun": {"content": ": Emphasizing distinctive encystment encasement patterns, localized pigment granules, and flagellar insertion geometry.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "indentFirstLine": {"magnitude": 18, "unit": "PT"}, "indentStart": {"magnitude": 36, "unit": "PT"}, "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 1174}, {"endIndex": 1315, "paragraph": {"elements": [{"endIndex": 1315, "startIndex": 1314, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 1314}]},
