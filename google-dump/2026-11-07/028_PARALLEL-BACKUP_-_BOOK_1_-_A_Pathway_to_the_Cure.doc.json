"body": {"content": [{"endIndex": 1, "sectionBreak": {"sectionStyle": {"columnSeparatorStyle": "NONE", "contentDirection": "LEFT_TO_RIGHT", "sectionType": "CONTINUOUS"}}}, {"endIndex": 163, "paragraph": {"elements": [{"endIndex": 163, "startIndex": 1, "textRun": {"content": "BOOK 1: A Pathway to the Cure\u000b© 2026 Douglas Schoonover. All Rights Reserved.\u000bPart of The Compendium — Unified Relativity Series\u000bCore Equation: Ec = Σ wi mi vi^x\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 1}, {"endIndex": 417, "paragraph": {"elements": [{"endIndex": 417, "startIndex": 163, "textRun": {"content": "2. Core Evidence Protocols\u000b2.1 The Lock Protocol\u000bClose all prior notes. Only what you observe exists in this encounter. This stops systemic fiction, copy/paste corruption, and inherited errors from entering the chart. Evidence begins at zero every time.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 163}, {"endIndex": 668, "paragraph": {"elements": [{"endIndex": 668, "startIndex": 417, "textRun": {"content": "2.2 The Ec Reality Check\u000bAt bedside: mass (mi) = severity, entanglement (wi) = how many conflicting opinions are pulling on the data, velocity (vi) = time since onset. If Ec is high, act now. This replaces static E=mc^2 with dynamic clinical reality.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 417}, {"endIndex": 840, "paragraph": {"elements": [{"endIndex": 840, "startIndex": 668, "textRun": {"content": "2.3 Final Authority Signature\u000bYou sign as Clinical Diagnostic Technician. No committee overrides without repeating 2.1-2.2. Final authority rests with direct observation.\u000b\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 668}]},
