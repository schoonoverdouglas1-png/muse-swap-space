"body": {"content": [{"endIndex": 1, "sectionBreak": {"sectionStyle": {"columnSeparatorStyle": "NONE", "contentDirection": "LEFT_TO_RIGHT", "sectionType": "CONTINUOUS"}}}, {"endIndex": 36, "paragraph": {"elements": [{"endIndex": 36, "startIndex": 1, "textRun": {"content": "BOOK 3: Chronomedicine & Nameology\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.okkyrgghoidw", "namedStyleType": "HEADING_1"}}, "startIndex": 1}, {"endIndex": 84, "paragraph": {"elements": [{"endIndex": 84, "startIndex": 36, "textRun": {"content": "© 2026 Douglas Schoonover. All Rights Reserved.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 36}, {"endIndex": 85, "paragraph": {"elements": [{"endIndex": 85, "startIndex": 84, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "indentFirstLine": {"unit": "PT"}, "indentStart": {"unit": "PT"}, "namedStyleType": "NORMAL_TEXT", "spaceAbove": {"unit": "PT"}, "spaceBelow": {"unit": "PT"}}}, "startIndex": 84}, {"endIndex": 170, "paragraph": {"elements": [{"endIndex": 169, "startIndex": 85, "textRun": {"content": "Part of The Compendium — Technical Manual for Linguistic Roots and Temporal Patterns", "textStyle": {"bold": true}}}, {"endIndex": 170, "startIndex": 169, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 85}, {"endIndex": 212, "paragraph": {"elements": [{"endIndex": 212, "startIndex": 170, "textRun": {"content": "Core Equation: $E_c = \\sum w_i m_i v_i^x$\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.2ps0368o5d7v", "namedStyleType": "HEADING_2"}}, "startIndex": 170}, {"endIndex": 235, "paragraph": {"elements": [{"endIndex": 235, "startIndex": 212, "textRun": {"content": "2. Temporal Signatures\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.q8l2nffi2iio", "namedStyleType": "HEADING_2"}}, "startIndex": 212}, {"endIndex": 256, "paragraph": {"elements": [{"endIndex": 256, "startIndex": 235, "textRun": {"content": "2.1 Time as Medicine\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.a161o3r7lbnf", "namedStyleType": "HEADING_3"}}, "startIndex": 235}, {"endIndex": 410, "paragraph": {"elements": [{"endIndex": 410, "startIndex": 256, "textRun": {"content": "Treat at biological hour, not clinic hour. Timestamp matters more than diagnosis code. Chronomedicine aligns intervention with body's temporal signature.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 256}, {"endIndex": 424, "paragraph": {"elements": [{"endIndex": 424, "startIndex": 410, "textRun": {"content": "2.2 Nameology\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.7olq7p721dph", "namedStyleType": "HEADING_3"}}, "startIndex": 410}, {"endIndex": 639, "paragraph": {"elements": [{"endIndex": 639, "startIndex": 424, "textRun": {"content": "Language lowers or raises $w_i$. Example: \"Autoimmune\" lowers entanglement (fiction label). Rename to \"Immune Misfire — investigating\" raises $w_i$ (accurate, open, investigable). Renaming is clinical intervention.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 424}, {"endIndex": 663, "paragraph": {"elements": [{"endIndex": 663, "startIndex": 639, "textRun": {"content": "2.3 Protection Protocol\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "headingId": "h.40785zk1xcwq", "namedStyleType": "HEADING_3"}}, "startIndex": 639}, {"endIndex": 825, "paragraph": {"elements": [{"endIndex": 825, "startIndex": 663, "textRun": {"content": "Government requires Google to save, but dual protection needed: cloud + offline USB + Meta backup. Dual $m_i$ (mass) protection with timestamps prevents erasure.\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 663}, {"endIndex": 826, "paragraph": {"elements": [{"endIndex": 826, "startIndex": 825, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "indentFirstLine": {"unit": "PT"}, "indentStart": {"unit": "PT"}, "namedStyleType": "NORMAL_TEXT", "spaceAbove": {"unit": "PT"}, "spaceBelow": {"unit": "PT"}}}, "startIndex": 825}, {"endIndex": 828, "paragraph": {"elements": [{"endIndex": 827, "horizontalRule": {"textStyle": {}}, "startIndex": 826}, {"endIndex": 828, "startIndex": 827, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 826}, {"endIndex": 829, "paragraph": {"elements": [{"endIndex": 829, "startIndex": 828, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "indentFirstLine": {"unit": "PT"}, "indentStart": {"unit": "PT"}, "namedStyleType": "NORMAL_TEXT", "spaceAbove": {"unit": "PT"}, "spaceBelow": {"unit": "PT"}}}, "startIndex": 828}, {"endIndex": 889, "paragraph": {"elements": [{"endIndex": 888, "startIndex": 829, "textRun": {"content": "Next: Add linguistic root tables and temporal dosing charts", "textStyle": {"italic": true}}}, {"endIndex": 889, "startIndex": 888, "textRun": {"content": "\n", "textStyle": {}}}], "paragraphStyle": {"direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT"}}, "startIndex": 829}]},
