"body": {"content": [{"endIndex": 1, "sectionBreak": {"sectionStyle": {"columnSeparatorStyle": "NONE", "contentDirection": "LEFT_TO_RIGHT", "sectionType": "CONTINUOUS"}}}, {"endIndex": 78, "paragraph": {"elements": [{"endIndex": 78, "startIndex": 1, "textRun": {"content": "I have synthesized the fungal analogues to complete your comparative matrix.\n", "textStyle": {}}}], "paragraphStyle": {"borderBetween": {"color": {}, "dashStyle": "SOLID", "padding": {"unit": "PT"}, "width": {"unit": "PT"}}, "borderBottom": {"color": {}, "dashStyle": "SOLID", "padding": {"unit": "PT"}, "width": {"unit": "PT"}}, "borderLeft": {"color": {}, "dashStyle": "SOLID", "padding": {"unit": "PT"}, "width": {"unit": "PT"}}, "borderRight": {"color": {}, "dashStyle": "SOLID", "padding": {"unit": "PT"}, "width": {"unit": "PT"}}, "borderTop": {"color": {}, "dashStyle": "SOLID", "padding": {"unit": "PT"}, "width": {"unit": "PT"}}, "direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT", "shading": {"backgroundColor": {}}}}, "startIndex": 1}, {"endIndex": 249, "paragraph": {"elements": [{"endIndex": 249, "startIndex": 78, "textRun": {"content": "While bacterial pathogens rely on diverse capsular polysaccharides (CPS), major fungal pathogens utilize analogous cell wall and capsular polymers to evade host immunity.\n", "textStyle": {}}}], "paragraphStyle": {"borderBetween": {"color": {}, "dashStyle": "SOLID", "padding": {"unit": "PT"}, "width": {"unit": "PT"}}, "borderBottom": {"color": {}, "dashStyle": "SOLID", "padding": {"unit": "PT"}, "width": {"unit": "PT"}}, "borderLeft": {"color": {}, "dashStyle": "SOLID", "padding": {"unit": "PT"}, "width": {"unit": "PT"}}, "borderRight": {"color": {}, "dashStyle": "SOLID", "padding": {"unit": "PT"}, "width": {"unit": "PT"}}, "borderTop": {"color": {}, "dashStyle": "SOLID", "padding": {"unit": "PT"}, "width": {"unit": "PT"}}, "direction": "LEFT_TO_RIGHT", "namedStyleType": "NORMAL_TEXT", "shading": {"backgroundColor": {}}, "spaceBelow": {"magnitude": 12, "unit": "PT"}}}, "startIndex": 78}, {"endIndex": 291, "paragraph": {"elements": [{"endIndex": 291, "startIndex": 249, "textRun": {"content": "Fungal Elements & Cross-Reference Mapping\n", "textStyle": {}}}], "paragraphStyle": {"borderBetween": {"color": {}, "dashStyle": "SOLID", "padding": {"unit": "PT"}, "width": {"unit": "PT"}}, "borderBottom": {"color": {}, "dashStyle": "SOLID", "padding": {"unit": "PT"}, "width": {"unit": "PT"}}, "borderLeft": {"color": {}, "dashStyle": "SOLID", "padding": {"unit": "PT"}, "width": {"unit": "PT"}}, "borderRight": {"color": {}, "dashStyle": "SOLID", "padding": {"unit": "PT"}, "width": {"unit": "PT"}}, "borderTop": {"color": {}, "dashStyle": "SOLID", "padding": {"unit": "PT"}, "width": {"unit": "PT"}}, "direction": "LEFT_TO_RIGHT", "namedStyleType": "HEADING_3", "shading": {"backgroundColor": {}}, "spaceAbove": {"unit": "PT"}}}, "startIndex": 249}, {"endIndex": 622, "paragraph": {"bullet": {"listId": "kix.list.1", "textStyle": {}}, "elements": [{"endIndex": 323, "startIndex": 291, "textRun": {"content": "Cryptococcus neoformans / gattii", "textStyle": {"bold": true, "italic": true}}}, {"endIndex": 324, "startIndex": 323, "textRun": {"content": ":", "textStyle": {"bold": true}}}, {"endIndex": 361, "startIndex": 324, "textRun": {"content": " The primary virulence factor is the ", "textStyle": {}}}, {"endIndex": 386, "startIndex": 361, "textRun": {"content": "Glucuronoxylomannan (GXM)", "textStyle": {"bold": true}}}, {"endIndex": 622, "startIndex": 386, "textRun": {"content": " capsule, alongside galactoxylomannan (GalXM). Functionally analogous to pneumococcal CPS, experimental GXM-protein conjugates (using CRM197 or TT) are researched to bridge bacterial conjugate architecture with fungal capsular targets.\n", "textStyle": {}}}], "paragraphStyle": {"borderBetween": {"color": {}, "dashStyle": "SOLID", "padding": {"unit": "PT"}, "width": {"unit": "PT"}}, "borderBottom": {"color": {}, "dashStyle": "SOLID", "padding": {"unit": "PT"}, "width": {"unit": "PT"}}, "borderLeft": {"color": {}, "dashStyle": "SOLID", "padding": {"unit": "PT"}, "width": {"unit": "PT"}}, "borderRight": {"color": {}, "dashStyle": "SOLID", "padding": {"unit": "PT"}, "width": {"unit": "PT"}}, "borderTop": {"color": {}, "dashStyle": "SOLID", "padding": {"unit": "PT"}, "width": {"unit": "PT"}}, "direction": "LEFT_TO_RIGHT", "indentFirstLine": {"magnitude": 12, "unit": "PT"}, "indentStart": {"magnitude": 30, "unit": "PT"}, "namedStyleType": "NORMAL_TEXT", "shading": {"backgroundColor": {}}}}, "startIndex": 291}, {"endIndex": 867, "paragraph": {"bullet": {"listId": "kix.list.1", "textStyle": {}}, "elements": [{"endIndex": 646, "startIndex": 622, "textRun": {"content": "Candida albicans / auris", "textStyle": {"bold": true, "italic": true}}}, {"endIndex": 647, "startIndex": 646, "textRun": {"content": ":", "textStyle": {"bold": true}}}, {"endIndex": 677, "startIndex": 647, "textRun": {"content": " Features a cell wall rich in ", "textStyle": {}}}, {"endIndex": 709, "startIndex": 677, "textRun": {"content": "mannan and beta-glucan complexes", "textStyle": {"bold": true}}}, {"endIndex": 867, "startIndex": 709, "textRun": {"content": ". The outer fibrillar layer consists of phosphopeptidomannan, which acts similarly to bacterial surface antigens in triggering pattern recognition receptors.\n", "textStyle": {}}}], "paragraphStyle": {"borderBetween": {"color": {}, "dashStyle": "SOLID", "padding": {"unit": "PT"}, "width": {"unit": "PT"}}, "borderBottom": {"color": {}, "dashStyle": "SOLID", "padding": {"unit": "PT"}, "width": {"unit": "PT"}}, "borderLeft": {"color": {}, "dashStyle": "SOLID", "padding": {"unit": "PT"}, "width": {"unit": "PT"}}, "borderRight": {"color": {}, "dashStyle": "SOLID", "padding": {"unit": "PT"}, "width": {"unit": "PT"}}, "borderTop": {"color": {}, "dashStyle": "SOLID", "padding": {"unit": "PT"}, "width": {"unit": "PT"}}, "direction": "LEFT_TO_RIGHT", "indentFirstLine": {"magnitude": 12, "unit": "PT"}, "indentSta